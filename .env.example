# OpenAI — Centro de Inteligencia Genera Solutions
OPENAI_API_KEY=sk-...
# Opcional (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Sesiones (obligatorio en Vercel). Genere una cadena larga aleatoria.
AUTH_SECRET=cambie-esta-clave-larga-aleatoria

# Redis / Vercel KV (obligatorio en Vercel para usuarios y cotizaciones)
# En Vercel: Storage → Create Database → Upstash Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=
