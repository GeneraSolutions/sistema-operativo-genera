# OpenAI — Centro de Inteligencia Genera Solutions
OPENAI_API_KEY=sk-...
# Opcional (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Sesiones (obligatorio en producción). Genere una cadena larga aleatoria.
AUTH_SECRET=cambie-esta-clave-larga-aleatoria

# Supabase Storage (reemplaza Vercel Blob)
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Project Settings → API → service_role (solo servidor, nunca el navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Bucket público que ya creó
SUPABASE_STORAGE_BUCKET=OSgenerasolutions

# Redis / Upstash (opcional; si hay Supabase, el OS lo usa primero)
KV_REST_API_URL=
KV_REST_API_TOKEN=
